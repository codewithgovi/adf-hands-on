{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "govi-adf"
		},
		"LS_ADLS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://goviadls.dfs.core.windows.net/"
		},
		"LS_Azure_Sql_Server_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "demo-dbase.database.windows.net"
		},
		"LS_Azure_Sql_Server_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "demo_sql_db"
		},
		"LS_Azure_Sql_Server_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "goviadmin"
		},
		"TGR_Event_Simple_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/ab7c09af-1330-4ad1-aa11-5763a4363a33/resourceGroups/test/providers/Microsoft.Storage/storageAccounts/goviadls"
		},
		"LS_Govi_Key_Vault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://govi-vault.vault.azure.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "govi-adf_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ADLS_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_properties_typeProperties_url')]"
					},
					"LS_Govi_Key_Vault_properties_typeProperties_baseUrl": {
						"value": "[parameters('LS_Govi_Key_Vault_properties_typeProperties_baseUrl')]"
					},
					"LS_Azure_Sql_Server_properties_typeProperties_server": {
						"value": "[parameters('LS_Azure_Sql_Server_properties_typeProperties_server')]"
					},
					"LS_Azure_Sql_Server_properties_typeProperties_database": {
						"value": "[parameters('LS_Azure_Sql_Server_properties_typeProperties_database')]"
					},
					"LS_Azure_Sql_Server_properties_typeProperties_userName": {
						"value": "[parameters('LS_Azure_Sql_Server_properties_typeProperties_userName')]"
					},
					"TGR_Event_Simple_properties_typeProperties_scope": {
						"value": "[parameters('TGR_Event_Simple_properties_typeProperties_scope')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}