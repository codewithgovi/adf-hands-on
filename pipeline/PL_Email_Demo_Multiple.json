{
	"name": "PL_Email_Demo_Multiple",
	"properties": {
		"activities": [
			{
				"name": "Send_Email",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Logic App Email Body",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"url": "https://prod-06.centralindia.logic.azure.com:443/workflows/751af425726240f48a3c82c4dcfc8d25/triggers/When_an_HTTP_request_is_received/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2FWhen_an_HTTP_request_is_received%2Frun&sv=1.0&sig=TI0FQM8y8GpaTshzo_Zs60aq7gOmDE6og7CImfi8jSs",
					"body": {
						"value": "@variables('logic_apps_body')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Logic App Email Body",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Prepare Email Subject",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Prepare Email Body with Status",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "logic_apps_body",
					"value": {
						"value": "{\"email_recepient\":\"@{pipeline().parameters.email_recepient}\",\n\"subject\":\"@{variables('email_subject')}\",\n\"body\":\"@{variables('email_body')}\"\n}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Prepare Email Subject",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "email_subject",
					"value": {
						"value": "Ingestion Completed",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Prepare Email Body with Status",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "email_body",
					"value": {
						"value": "The ingestion process has been completed for all tables and below is the status:\n@{replace(string(pipeline().parameters.table_status), '\"','')}\n\nPipeline Run id = @{pipeline().RunId}\n",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"email_recepient": {
				"type": "string"
			},
			"table_status": {
				"type": "array"
			}
		},
		"variables": {
			"logic_apps_body": {
				"type": "String"
			},
			"email_subject": {
				"type": "String"
			},
			"email_body": {
				"type": "String"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-10-28T19:05:18Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}